{
  "explorer.width": 30,
  "explorer.icon.enableNerdfont": true,
  "explorer.previewAction.onHover": false,
  "explorer.keyMappings": {
    "<cr>": ["expandable?", "expand", "open"],
    "v": "open:vsplit"
  },

  "coc.preferences.formatOnSaveFiletypes": [
      "python",
      "json",
      "java",
      "js",
      "ts"
  ],

  "python.analysis.typeCheckingMode": "off",

  "codeLens.enable": true,
  "java.referencesCodeLens.enabled": true,
  "java.implementationsCodeLens.enabled": true,
  "java.completion.enabled": true,

  "java.home": "/Library/Java/JavaVirtualMachines/temurin-11.jdk/Contents/Home",
  "java.jdt.ls.vmargs": "-javaagent:/usr/local/share/lombok/lombok.jar -Xbootclasspath/a:/usr/local/share/lombok/lombok.jar",
  "clangd.path": "/Users/user/.config/coc/extensions/coc-clangd-data/install/12.0.0/clangd_12.0.0/bin/clangd",
  
  "metal.javaHome":"/Library/Java/JavaVirtualMachines/temurin-11.jdk/Contents/Home"
}
